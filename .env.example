# ClinOps-AI backend configuration
APP_NAME=ClinOps-AI
ENVIRONMENT=development

# Database (SQLite file by default; any SQLAlchemy URL works)
DATABASE_URL=sqlite:///./clinops_ai.db

# Authentication
# Set JWT_SECRET_KEY in your local .env file.
# Never commit a real signing secret.
JWT_SECRET_KEY=U0y7tr3d7RowF8I9u1gQLZe3saPrGIt9wqHg8Zvys3J0xetYAur2N3NfwzqJ-M_X
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Use exact browser origins; do not use "*" while credentials are enabled.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# Speech-to-text
# ASR_MODE=whisper uses faster-whisper if the model can be loaded. For long-form
# medical recordings, install FFmpeg and prefer a cached or downloadable model.
# ASR_MODE=demo always uses a clearly-labelled canned transcript so the app
# remains runnable offline and avoids fabricating real transcription.
ASR_MODE=auto
WHISPER_MODEL=small
DEVICE=auto
MODEL_CACHE_DIR=./model_cache
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Accept the model conditions on Hugging Face, then set a read token locally.
HF_TOKEN=
FFMPEG_REQUIRED=true

# File storage
UPLOAD_DIR=./uploads/audio
PDF_OUTPUT_DIR=./outputs/pdfs
MAX_AUDIO_SIZE=26214400

# Language
DEFAULT_LANGUAGE=en

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
